{
  "schema": "exchange.api_probe.profile.v1",
  "venue": "gate",
  "display_name": "Gate",
  "provenance": "built_in",
  "products": [
    {
      "id": "spot",
      "default_symbol": "BTC_USDT",
      "symbol_format": "{base}_{quote}",
      "channels": [
        {
          "id": "trades",
          "kind": "trade",
          "support": "observed_only",
          "transport": "ws",
          "wire": "json",
          "host": "api.gateio.ws",
          "port": 443,
          "path": "/ws/v4/",
          "subscribe": "{\"time\":1,\"channel\":\"spot.trades\",\"event\":\"subscribe\",\"payload\":[\"{symbol}\"]}",
          "compression": "none",
          "capabilities": [
            "live_trades"
          ]
        },
        {
          "id": "trades_sbe",
          "kind": "trade",
          "support": "adapter_required",
          "transport": "ws",
          "wire": "sbe",
          "host": "api.gateio.ws",
          "port": 443,
          "path": "/ws/v4/ws/spot/sbe?sbe_schema_id=2",
          "subscribe": "{\"time\":1,\"channel\":\"spot.trades\",\"event\":\"subscribe\",\"payload\":[\"{symbol}\"]}",
          "subscribe_binary": false,
          "compression": "none",
          "adapter": "adapters/gate_sbe",
          "capabilities": [
            "live_trades"
          ]
        },
        {
          "id": "book_ticker_sbe",
          "kind": "book_ticker",
          "support": "adapter_required",
          "transport": "ws",
          "wire": "sbe",
          "host": "api.gateio.ws",
          "port": 443,
          "path": "/ws/v4/ws/spot/sbe?sbe_schema_id=2",
          "subscribe": "{\"time\":1,\"channel\":\"spot.book_ticker\",\"event\":\"subscribe\",\"payload\":[\"{symbol}\"]}",
          "subscribe_binary": false,
          "compression": "none",
          "adapter": "adapters/gate_sbe",
          "capabilities": [
            "live_bbo"
          ],
          "depth_levels": 1
        },
        {
          "id": "orderbook_sbe",
          "kind": "depth",
          "support": "adapter_required",
          "transport": "ws",
          "wire": "sbe",
          "host": "api.gateio.ws",
          "port": 443,
          "path": "/ws/v4/ws/spot/sbe?sbe_schema_id=2",
          "subscribe": "{\"time\":1,\"channel\":\"spot.obu\",\"event\":\"subscribe\",\"payload\":[\"ob.{symbol}.50\"]}",
          "subscribe_binary": false,
          "compression": "none",
          "adapter": "adapters/gate_sbe",
          "capabilities": [
            "live_l2"
          ],
          "depth_semantics": "stream_snapshot_delta",
          "depth_levels": 50
        }
      ],
      "discovery": []
    },
    {
      "id": "futures",
      "default_symbol": "BTC_USDT",
      "symbol_format": "{base}_{quote}",
      "channels": [
        {
          "id": "trades_sbe",
