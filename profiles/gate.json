          "wire": "sbe",
          "host": "fx-ws.gateio.ws",
          "port": 443,
          "path": "/v4/ws/usdt/sbe?sbe_schema_id=1",
          "subscribe": "{\"time\":1,\"channel\":\"futures.trades\",\"event\":\"subscribe\",\"payload\":[\"{symbol}\"]}",
          "subscribe_binary": false,
          "compression": "none",
          "adapter": "adapters/gate_sbe",
          "capabilities": [
            "live_trades"
          ]
        },
        {
          "id": "book_ticker_sbe",
          "kind": "book_ticker",
          "support": "adapter_required",
          "transport": "ws",
          "wire": "sbe",
          "host": "fx-ws.gateio.ws",
          "port": 443,
          "path": "/v4/ws/usdt/sbe?sbe_schema_id=1",
          "subscribe": "{\"time\":1,\"channel\":\"futures.book_ticker\",\"event\":\"subscribe\",\"payload\":[\"{symbol}\"]}",
          "subscribe_binary": false,
          "compression": "none",
          "adapter": "adapters/gate_sbe",
          "depth_levels": 1,
          "capabilities": [
