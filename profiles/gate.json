          "transport": "ws",
          "wire": "sbe",
          "host": "fx-ws.gateio.ws",
          "port": 443,
          "path": "/v4/ws/usdt/sbe?sbe_schema_id=1",
          "subscribe": "{\"time\":1,\"channel\":\"futures.obu\",\"event\":\"subscribe\",\"payload\":[\"ob.{symbol}.50\"]}",
          "subscribe_binary": false,
          "compression": "none",
          "adapter": "adapters/gate_sbe",
          "depth_semantics": "stream_snapshot_delta",
          "depth_levels": 50,
