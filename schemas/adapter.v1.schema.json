{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exchange.api_probe.adapter.v1",
  "title": "Exchange API Probe adapter record",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "kind", "frame_id", "channel_id", "payload_base64"],
      "properties": {
        "schema": {"const": "exchange.api_probe.adapter.v1"},
        "kind": {"const": "frame"},
        "frame_id": {"type": "integer", "minimum": 0},
        "channel_id": {"type": "string"},
        "payload_base64": {"type": "string"}
      }
    },
    {
      "type": "object",
      "required": ["schema", "kind", "frame_id", "event_kind"],
      "properties": {
        "schema": {"const": "exchange.api_probe.adapter.v1"},
        "kind": {"const": "event"},
        "frame_id": {"type": "integer", "minimum": 0},
        "event_kind": {"enum": ["trade", "book_ticker", "depth", "funding", "control"]}
      }
    }
  ]
}
